# Copy this file to .env and fill in your values.
# The real .env is gitignored and never committed — only .env.example is.
#
# spring-dotenv loads .env automatically on mvn spring-boot:run.
# Manual export works too; both are read by Spring.

SPRING_PROFILES_ACTIVE=dev

DB_USER=
DB_PASSWORD=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

ANTHROPIC_API_KEY=

# Optional — OpenAI API key for RAG semantic retrieval.
# When set, Fractals embeds your entire Spotify library and uses cosine similarity
# to find the most relevant tracks for each recommendation request.
# When not set, Fractals falls back to the top-10 tracks context (no library embedding).
OPENAI_API_KEY=

# Optional — playlist reasoning instructions.
# If not set, Fractals falls back to generic playlist context recommendations.
# Multi-line: put the full value on ONE line inside double quotes.
# dotenv-java expands \n sequences to real newlines before Spring sees the value.
PROMPT_REASONING_INSTRUCTIONS=
